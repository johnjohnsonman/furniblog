# Google Search Console (admin SEO dashboard). Service account JSON →
# Cloud Console; add the service-account email as a user on the GSC property.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GSC_SITE_URL=sc-domain:chairpedia.com

# Amazon Creators API (replaces retired PA-API 5.0) — product images by ASIN.
# From Associates Central > Tools > Product Advertising API > Creators API > Create App > Add new credential.
# Requires 10 qualifying sales in the trailing 30 days to actually return data.
PAAPI_ACCESS_KEY=
# Credential ID (OAuth client_id, amzn1.*)
PAAPI_SECRET_KEY=
# Credential Secret (OAuth client_secret; shown once)
PAAPI_PARTNER_TAG=furniblog0e-20
# Optional overrides: PAAPI_TOKEN_ENDPOINT, PAAPI_BASE_URL, PAAPI_MARKETPLACE, PAAPI_SCOPE
